rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 허용 명단: Firestore의 config/allowlist 문서에 있는 이메일만 기록을 읽고 쓸 수 있음
    // (문서 예: emails = ["me@gmail.com", "friend@gmail.com"]) 이 문서는 앱에서 읽거나 고칠 수 없고, 운영자가 콘솔에서만 관리
    function invited() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/config/allowlist)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/allowlist).data.emails;
    }

    match /users/{uid}/data/{docId} {
      // 본인 기록 삭제는 명단에서 빠진 뒤에도 가능 (탈퇴·정리용)
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow read: if invited() && request.auth.uid == uid;
      allow create, update: if invited()
        && request.auth.uid == uid
        && (docId in ['habits', 'categories', 'settings'] || docId.matches('logs-[0-9]{4}-[0-9]{2}'))
        && request.resource.data.keys().hasOnly(['items', 'theme', 'language']);
    }

    // 그 밖의 모든 경로(config 포함)는 앱에서 접근할 수 없음
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
